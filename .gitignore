# Generated, not source: deterministic build products of tools/ (see docs/).
# tiny-qwen4exp.gguf is ~113 MB, over GitHub's 100 MB file limit -- regenerate with
#   python tools/make_tiny_model.py
bench/tiny-*.gguf
bench/wide-*.gguf
bench/micro/*.exe
bench/micro/*.obj
bench/micro/*.bin
bench/micro/*.dll
bench/micro/*.txt
*.log
build*/
pack/
logs/
__pycache__/
.pytest_cache/
*.pyc

# plan v0.3 P1 (repository hygiene, review E1): profiler captures and large diagnostic dumps stay out of git.
*.nsys-rep

# Pi harness metadata (local session state, not project source)
*.sqlite
*.npz
*.occ1
td.log

# created by setup.py on the user's machine
/.venv/
/build/
/third_party/llama.cpp*
/models/
/packs/
/mtp/
/run-*.bat
/run-*.sh
/AryaStrata-Tray.vbs
/strata-*.json
/strata-*.json.bak
/strata-*.log
/strata-*.warm-start
/build-strata.bat
/build-strata-cuda12.bat
/build-strata-hip-win.bat
/build-cuda12/
/.strata-mcp/

# image encoder (setup.py --vision): build output and the generated build script
build-vision*/
build-vision.bat
build-vision-cuda12.bat

# setup.py outputs (engine, downloads) and release builds
/engine/
/engine-cuda12/
/engine-poly/
/engine-arya/
# /engine-inkling/ is not ignored as a whole: engine-inkling/build.ps1 is the recipe that builds the
# Inkling engine here, so the lane ignores its inputs and outputs one by one, further down.
/build-strata-poly.bat
/build-vision-poly.bat
/engine-glm/
/build-strata-glm.bat
# Basalt (engines.json pins it; setup.py --with-basalt installs the release into this folder).  Its expert
# profiles are generated per model by basalt-bench, so they stay here too.
/engine-basalt/*.exe
/engine-basalt/*.pdb
/engine-basalt/*.dll
/engine-basalt/*.log
/engine-basalt/BUILD.json
/engine-basalt/data/
/engine-basalt/LICENSE
/engine-basalt/THIRD_PARTY_LICENSES
/build-release*/
/dist/
*.done
/third_party/*.zip
/third_party/metal-cpp/

# IDEs
/local-data/
.vscode/
.idea/
.cursor/

/.ccache/
/.rocm-win/

# local Windows HIP packaging output
dist-hip/

# playwright tool artefacts (browser automation cache, never source)
/.playwright-mcp/

# local run-config backups written next to the gitignored strata-*.json
/strata-*.json.*

# scratch folders a test run leaves in the working directory (test_server's temp models)
/tmp*/
# the page's own settings files, written beside the run config: per machine, and they can hold tokens
/mcp-servers.json
/mcp-servers.json.*
/websearch.json
/websearch.json.*
# the ComfyUI settings the page keeps beside the run config (may hold a proxy token)
/comfyui.json
/comfyui.json.*
# a gallery written by mistake beside the source: it belongs under local-data
/image-gallery/
# the vision encoder's scratch folders beside the app (random suffix, .sve cache): never source
/strata-vision-*/
*.sve
# NInfer backend: the built engine binary (engine-ninfer/build.ps1 writes it)
/engine-ninfer/*.exe
/engine-ninfer/*.pdb
/engine-ninfer/BUILD.json
# Inkling backend: the vendored source, the build tree and the built engine (engine-inkling/build.ps1)
/engine-inkling/src/
/engine-inkling/build/
/engine-inkling/scratch/
/engine-inkling/*.exe
/engine-inkling/*.pdb
/engine-inkling/*.dll
/engine-inkling/*.log
/engine-inkling/BUILD.json
