+PreparedPrompt Frontend::prepare_tokens_with_vision(std::vector<TokenId> token_ids,
+                                                    std::vector<ExternalVisionItem> items,
+                                                    TokenId image_pad_token,
+                                                    bool allow_prefix_identity) const {
+    const auto start = Clock::now();
+    if (items.empty()) {
+        throw std::invalid_argument("external vision requires at least one item");
+    }
+    if (token_ids.size() > impl_->max_context) {
+        throw_context_length_exceeded(impl_->max_context);
+    }
+    (void)checked_token_count(token_ids.size());
+    for (const TokenId token : token_ids) {
+        if (!impl_->tokenizer->is_valid_token(token)) {
+            throw std::out_of_range("prompt token is outside the checkpoint vocabulary: " +
+                                    std::to_string(token));
+        }
+    }
+    auto prepared              = std::make_unique<PreparedPromptData>();
+    PreparedPromptData& result = *prepared;
+    result.token_ids           = std::move(token_ids);
+    assign_text_positions(result);
+    // External embeddings are not part of the token ids, so two prompts with different
+    // pictures would look identical to the prefix cache. Do not publish or take a cached
+    // prefix for a vision prompt: stale picture state is worse than a cold prefill.
+    result.identity.reusable                  = false;
+    result.context_cache.retention            = runtime::RetentionClass::RecentPrivate;
+    result.context_cache.update_session_index = false;
+
+    std::size_t cursor       = 0;
+    std::size_t patch_cursor = 0;
+    std::uint64_t vision_tokens = 0;
+    for (ExternalVisionItem& item : items) {
+        const std::uint64_t merged_tokens =
+            static_cast<std::uint64_t>(item.nx) * static_cast<std::uint64_t>(item.lines);
+        const std::uint64_t embedding_values =
+            static_cast<std::uint64_t>(item.rows) * static_cast<std::uint64_t>(item.columns);
+        if (item.rows == 0 || item.nx == 0 || item.lines == 0 || item.columns == 0 ||
+            merged_tokens != item.rows || embedding_values != item.embeddings_bf16.size()) {
+            throw std::invalid_argument("external vision item has an invalid shape");
+        }
+        while (cursor < result.token_ids.size() && result.token_ids[cursor] != image_pad_token) {
+            ++cursor;
+        }
+        const std::size_t begin = cursor;
+        while (cursor < result.token_ids.size() && result.token_ids[cursor] == image_pad_token) {
+            ++cursor;
+        }
+        if (cursor - begin != item.rows) {
+            throw std::invalid_argument("external vision item does not match an image_pad run");
+        }
+        for (std::size_t index = begin; index < cursor; ++index) {
+            result.token_types[index] = static_cast<std::uint8_t>(PromptModality::Image);
+        }
+        VisionItem vision;
+        vision.modality = PromptModality::Image;
+        vision.grid = VisionGrid{.temporal = 1,
+                                 .height   = static_cast<std::int32_t>(2 * item.lines),
+                                 .width    = static_cast<std::int32_t>(2 * item.nx)};
+        vision.patch_begin    = patch_cursor;
+        vision.patch_count    = static_cast<std::size_t>(4) * item.rows;
+        vision.token_spans.push_back(TokenSpan{.begin = begin, .count = item.rows});
+        vision.external_embeddings = std::move(item.embeddings_bf16);
+        vision.external_columns    = item.columns;
+        patch_cursor += vision.patch_count;
+        vision_tokens += item.rows;
+        result.vision_items.push_back(std::move(vision));
+        result.prepare.media_items += 1;
+    }
+    if (std::find(result.token_ids.begin() + static_cast<std::ptrdiff_t>(cursor),
+                  result.token_ids.end(), image_pad_token) != result.token_ids.end()) {
+        throw std::invalid_argument("prompt has image_pad tokens with no external vision item");
+    }
+    result.prepare.raw_patches   = patch_cursor;
+    result.prepare.vision_tokens = vision_tokens;
+    result.prepare.seconds       = std::chrono::duration<double>(Clock::now() - start).count();
+    return PreparedPrompt(std::move(prepared));
+}
