@@ -0,0 +1,85 @@
+// Minimal portable 128-bit helpers for the few exact cost calculations in the
+// engine. MSVC (and nvcc's MSVC host pass) has no __int128 on x64, so the
+// Windows build uses _umul128 and the 64-bit portable path uses __int128.
+#pragma once
+
+#include <cstdint>
+#include <limits>
+
+#if defined(_MSC_VER) && defined(_M_X64)
+#include <intrin.h>
+#endif
+
+namespace ninfer::wide {
+
+struct u128 {
+    std::uint64_t hi = 0;
+    std::uint64_t lo = 0;
+
+    [[nodiscard]] friend constexpr bool operator==(u128, u128) noexcept = default;
+};
+
+[[nodiscard]] inline u128 mul(std::uint64_t left, std::uint64_t right) noexcept {
+#if defined(_MSC_VER) && defined(_M_X64)
+    u128 out;
+    out.lo = _umul128(left, right, &out.hi);
+    return out;
+#else
+    const unsigned __int128 product = static_cast<unsigned __int128>(left) * right;
+    return u128{static_cast<std::uint64_t>(product >> 64U),
+                static_cast<std::uint64_t>(product)};
+#endif
+}
+
+[[nodiscard]] inline u128 add_saturated(u128 left, u128 right) noexcept {
+    u128 out;
+    out.lo               = left.lo + right.lo;
+    const std::uint64_t carry = out.lo < left.lo ? 1U : 0U;
+    if (left.hi > std::numeric_limits<std::uint64_t>::max() - right.hi ||
+        left.hi + right.hi > std::numeric_limits<std::uint64_t>::max() - carry) {
+        return u128{std::numeric_limits<std::uint64_t>::max(),
+                    std::numeric_limits<std::uint64_t>::max()};
+    }
+    out.hi = left.hi + right.hi + carry;
+    return out;
+}
+
+[[nodiscard]] inline u128 shr(std::uint64_t value, unsigned shift) noexcept {
+    return u128{0, value >> shift};
+}
+
+[[nodiscard]] inline u128 shr(std::uint64_t hi, std::uint64_t lo, unsigned shift) noexcept {
+    if (shift == 0) { return u128{hi, lo}; }
+    if (shift >= 64) { return u128{0, hi >> (shift - 64U)}; }
+    return u128{hi >> shift, (lo >> shift) | (hi << (64U - shift))};
+}
+
+[[nodiscard]] inline u128 shr(u128 value, unsigned shift) noexcept {
+    return shr(value.hi, value.lo, shift);
+}
+
+[[nodiscard]] inline int compare(u128 left, u128 right) noexcept {
+    if (left.hi != right.hi) { return left.hi < right.hi ? -1 : 1; }
+    if (left.lo != right.lo) { return left.lo < right.lo ? -1 : 1; }
+    return 0;
+}
+
+// Compares left_a * right_a against left_b * right_b without truncation.
+[[nodiscard]] inline int compare_products(std::uint64_t left_a, std::uint64_t right_a,
+                                          std::uint64_t left_b,
+                                          std::uint64_t right_b) noexcept {
+    return compare(mul(left_a, right_a), mul(left_b, right_b));
+}
+
+[[nodiscard]] inline std::uint64_t saturated_u64(u128 value) noexcept {
+    return value.hi == 0 ? value.lo : std::numeric_limits<std::uint64_t>::max();
+}
+
+[[nodiscard]] inline bool fits_u64(u128 value) noexcept { return value.hi == 0; }
+
+[[nodiscard]] inline std::uint64_t saturated_product(std::uint64_t left,
+                                                     std::uint64_t right) noexcept {
+    return saturated_u64(mul(left, right));
+}
+
